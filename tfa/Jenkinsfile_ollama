@Library('ci-shared-lib') _

pipeline {
    options {
        buildDiscarder(logRotator(daysToKeepStr: '30'))
        timeout(time: 8, unit: 'HOURS')
    }
    agent {
        kubernetes {
            defaultContainer 'tfa-container'
            yamlFile 'tfa/JenkinsAgent_ollama.yaml'
        }
    }
    parameters {
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'The GIT branch to checkout')
    }
    environment {
        BUILD_URL = sh(returnStdout: true, script: "echo ${env.BUILD_URL}").trim()
        GITHUB_TOKEN = credentials('vincent-github-token')
        WORKDIR = "${env.WORKSPACE}/ci"
        PATH="${WORKDIR}/bin:${env.PATH}"
    } 
    stages {
        stage('TFA') {
            steps {
                catchError(stageResult: 'UNSTABLE',  buildResult: null) { 
                sh """
                    # 1. Start Ollama in the background
                    ollama serve > ollama.log 2>&1 &
                    
                    # 2. Wait for it to be ready
                    echo "Starting Ollama..."
                    until curl -s localhost:11434/api/tags > /dev/null; do sleep 2; done
                    
                    # 3. Pull a small model (crucial for 4Gi RAM limit)
                    # ollama pull tinyllama
                    ollama pull llama3.21
                    
                    echo "----- Execution phase -----"
                    cd tfa/claude/analyze_and_fix
                    mkdir -p tests_analysis .
                    ls

                    # convert the grc junit.xml files into a single json file that has the failed test cases only
                    python3 junit_xml_to_json.py junit_xml_files/* --output tests_analysis/grc_failed_tests.json --simple

                    # Analyze the failures in the generated json file, provide fix suggestions and generate them into a final json file that is ready for processing 
                    # python3 analyze_and_suggest_fixes.py tests_analysis/grc_failed_tests.json --model llama3.1 --output tests_analysis/analysis_and_fixes.json
                    python3 analyze_and_suggest_fixes.py tests_analysis/grc_failed_tests.json --model llama3.2 --output tests_analysis/analysis_and_fixes.json --yes --skip-verify
                """
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'tfa/claude/analyze_and_fix/tests_analysis/*', followSymlinks: false
        }
    }
}