@Library('ci-shared-lib') _

def setupGCP() {
    echo "Setting up GCP environment for OpenShift installation"
    sh """
        export GOOGLE_APPLICATION_CREDENTIALS=$GOOGLE_APPLICATION_CREDENTIALS
        export GOOGLE_CLOUD_PROJECT=$GCP_PROJECT_ID
        
        mkdir -p ~/.gcp
        cp $GOOGLE_APPLICATION_CREDENTIALS ~/.gcp/osServicePrincipal.json

        # Check if gcloud is installed
        if ! command -v gcloud &> /dev/null; then
            echo "gcloud not found. Installing Google Cloud SDK..."
            
            # Download the installer and save it with the correct name
            curl -o install-sdk.sh https://sdk.cloud.google.com
            
            # Run the installer non-interactively
            chmod +x install-sdk.sh
            bash install-sdk.sh --disable-prompts --install-dir=$WORKDIR/bin/
            
            # Source the path file to update the PATH for this script
            source $WORKDIR/bin/google-cloud-sdk/path.bash.inc
        fi

        # Authenticate with service account
        # gcloud auth activate-service-account --key-file=$GOOGLE_APPLICATION_CREDENTIALS
        # gcloud config set project $GCP_PROJECT_ID
        
        # Verify authentication
        # gcloud auth list
        # gcloud projects describe $GCP_PROJECT_ID
    """
}

def setupClaudeCli() {
    echo "Setting up Claude CLI"
    sh """
        
        # Export the variable AND run the command in the same script
        # export JENKINS_APPLICATION_CREDENTIALS=$JENKINS_APPLICATION_CREDENTIALS
        export GOOGLE_APPLICATION_CREDENTIALS=$GOOGLE_APPLICATION_CREDENTIALS
        export CLAUDE_APPLICATION_CREDENTIALS=$CLAUDE_APPLICATION_CREDENTIALS
        mkdir -p ~/.config/gcloud
        cp $CLAUDE_APPLICATION_CREDENTIALS ~/.config/gcloud/application_default_credentials.json
        
        echo "--- Verifying ADC configuration file ---"
        # cat ~/.config/gcloud/application_default_credentials.json

        export CLAUDE_CODE_USE_VERTEX=1
        export CLOUD_ML_REGION=us-east5
        export ANTHROPIC_VERTEX_PROJECT_ID=$ANTHROPIC_VERTEX_PROJECT_ID

        echo 'export CLAUDE_CODE_USE_VERTEX=1' >> ~/.bashrc
        echo 'export CLOUD_ML_REGION=us-east5' >> ~/.bashrc
        echo 'export ANTHROPIC_VERTEX_PROJECT_ID=$ANTHROPIC_VERTEX_PROJECT_ID' >> ~/.bashrc
        source ~/.bashrc

        mkdir ~/.npm-global
        npm config set prefix '~/.npm-global' 
        echo 'export PATH=$PATH:$HOME/.npm-global/bin' >> ~/.bashrc
        source ~/.bashrc

        # Install Claude Code (If you previously installed Claude Code, you must first uninstall)
        # npm uninstall -g @anthropic-ai/claude-code
        npm install -g @anthropic-ai/claude-code 

        # $WORKDIR/bin/google-cloud-sdk/bin/gcloud projects add-iam-policy-binding $ANTHROPIC_VERTEX_PROJECT_ID \
        #    --member="serviceAccount:vboulos@redhat.com" \
        #    --role="roles/aiplatform.user"
        
        #"$WORKDIR/bin/google-cloud-sdk/bin/gcloud projects add-iam-policy-binding $ANTHROPIC_VERTEX_PROJECT_ID \
        #    --member="user:vboulos@redhat.com" \
        #    --role="roles/aiplatform.user

        # list of projects
        # $WORKDIR/bin/google-cloud-sdk/bin/gcloud projects list --format="json"
        
        $WORKDIR/bin/google-cloud-sdk/bin/gcloud auth activate-service-account --key-file=$GOOGLE_APPLICATION_CREDENTIALS
        $WORKDIR/bin/google-cloud-sdk/bin/gcloud auth application-default set-quota-project cloudability-it-gemini
        $WORKDIR/bin/google-cloud-sdk/bin/gcloud config set project $ANTHROPIC_VERTEX_PROJECT_ID
        $WORKDIR/bin/google-cloud-sdk/bin/gcloud auth list

        

        # Run claude cli
        # ~/.npm-global/bin/claude "what is the latest java version"
        # Check the status
        # /status
        # Exit
        # exit

    """
}

pipeline {
    options {
        buildDiscarder(logRotator(daysToKeepStr: '30'))
        timeout(time: 8, unit: 'HOURS')
    }
    agent {
        kubernetes {
            defaultContainer 'tfa-container'
            yamlFile 'tfa/JenkinsAgent.yaml'
        }
    }
    parameters {
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'The GIT branch to checkout')
    }
    environment {
        BUILD_URL = sh(returnStdout: true, script: "echo ${env.BUILD_URL}").trim()
        GITHUB_TOKEN = credentials('vincent-github-token')
        WORKDIR = "${env.WORKSPACE}/ci"
        PATH="${WORKDIR}/bin:${env.PATH}"
        // GCP credentials
        GOOGLE_APPLICATION_CREDENTIALS=credentials('vincent-gcp-sa')
        CLAUDE_APPLICATION_CREDENTIALS=credentials('vincent-claude-app-creds')
        JENKINS_APPLICATION_CREDENTIALS=credentials('jenkins-pics-gcp-sa')
        GCP_PROJECT_ID='gc-acm-test'
        ANTHROPIC_VERTEX_PROJECT_ID='itpc-gcp-hcm-pe-eng-claude'
        
    } 
    stages {
        stage('Build') {
            steps {                
                sh """  
                rm -rf results     
                # export npm_config_unsafe_perm=true
                # npm config get unsafe-perm                    
                # npm ci
                # echo $PATH
                # /usr/local/bin/node --version
                # /usr/local/bin/npm --version
                """
                script {
                    setupGCP()
                    setupClaudeCli()
                }
            }
        }
        stage('TFA') {
            steps {
                catchError(stageResult: 'UNSTABLE',  buildResult: null) { 
                sh """
                    echo "----- Execution phase -----"
                    cd tfa/claude/analyze_and_fix
                    mkdir -p tests_analysis .
                    ls

                    # convert the grc junit.xml files into a single json file that has the failed test cases only
                    python3 junit_xml_to_json.py junit_xml_files/* --output tests_analysis/grc_failed_tests.json --simple

                    # Analyze the failures in the generated json file, provide fix suggestions and generate them into a final json file that is ready for processing 
                    python3 analyze_and_suggest_fixes.py tests_analysis/grc_failed_tests.json --output tests_analysis/analysis_and_fixes.json
                """
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'tests_analysis/*', followSymlinks: false
        }
    }
}